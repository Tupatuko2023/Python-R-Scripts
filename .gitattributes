* text=auto eol=lf

# Platform-specific overrides
*.ps1 text eol=crlf
# Keep the hash-bound v2 receiver byte-stable across Windows checkouts.
Fear-of-Falling/scripts/ps7/receive_artifact_bundle.ps1 text eol=lf

# Text files (force LF)
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py  text eol=lf
*.csv text eol=lf
*.r   text eol=lf
*.R   text eol=lf
*.Rmd text eol=lf
*.qmd text eol=lf
*.sh  text eol=lf
.markdownlint.json text eol=lf
.markdownlintignore text eol=lf
.gitattributes text eol=lf

# Notebooks: strip outputs and use notebook-aware diff
*.ipynb filter=nbstripout
*.zpln filter=nbstripout
*.ipynb diff=ipynb

# Binary files / LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg -text
*.jpeg -text
*.gif -text
*.svg -text
*.pdf -text
*.fig -text

Fear-of-Falling/data/external/KaatumisenPelko.csv filter=git-crypt diff=git-crypt -text
